FROM php:8.3-fpm

RUN apt-get update && apt-get install -y libmcrypt-dev mariadb-client libpng-dev libjpeg-dev libwebp-dev libfreetype6-dev ffmpeg libicu-dev \
    && docker-php-ext-install pdo_mysql \
    && docker-php-ext-install exif \
    && docker-php-ext-install intl \
    && pecl install mcrypt \
    && pecl install redis \
    && docker-php-ext-enable mcrypt redis

RUN apt install -y git libmagickwand-dev && \
    git clone https://github.com/Imagick/imagick.git --depth 1 /tmp/imagick && \
    cd /tmp/imagick && \
    git fetch origin master && \
    git switch master && \
    cd /tmp/imagick && \
    phpize && \
    ./configure && \
    make && \
    make install && \
    docker-php-ext-enable imagick

WORKDIR /var/www

CMD ["php-fpm"]
